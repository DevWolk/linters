# PHPStan Configuration
# https://phpstan.org/user-guide/getting-started
# https://phpstan.org/config-reference

parameters:
    # Analysis level (0-9, or 'max')
    # Level 8 provides strict type checking without being overly pedantic
    level: 8

    # Paths to analyze/exclude are injected by the generator

    # Report all errors, even in baseline
    reportUnmatchedIgnoredErrors: false

    # File extensions to analyze
    fileExtensions:
        - php
