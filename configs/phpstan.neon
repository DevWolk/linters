# PHPStan Configuration
# https://phpstan.org/user-guide/getting-started
# https://phpstan.org/config-reference

parameters:
    # Analysis level (0-9, or 'max')
    # Level 8 provides strict type checking without being overly pedantic
    level: 8

    # Paths to analyze/exclude are injected by the generator

    # Enable strict rules for better code quality
    strictRules:
        allRules: true

    # Additional quality checks
    checkMissingIterableValueType: true
    checkGenericClassInNonGenericObjectType: true
    checkAlwaysTrueCheckTypeFunctionCall: true
    checkAlwaysTrueInstanceof: true
    checkAlwaysTrueStrictComparison: true
    checkExplicitMixedMissingReturn: true
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true

    # Report all errors, even in baseline
    reportUnmatchedIgnoredErrors: false

    # File extensions to analyze
    fileExtensions:
        - php

    # Symfony-specific settings (if applicable)
    symfony:
        container_xml_path: null
        constant_hassers: false

    # Ignore specific error patterns (use sparingly)
    ignoreErrors:
        # Example: Ignore specific deprecation warnings
        # - '#Call to deprecated method#'

    # Bootstrap file for loading project-specific code
    # bootstrapFiles:
    #     - %rootDir%/../../bootstrap.php

    # Bleeding edge features (enable at your own risk)
    # polluteScopeWithLoopInitialAssignments: false
    # polluteScopeWithAlwaysIterableForeach: false

    # Baseline file (uncomment to use)
    # includes:
    #     - phpstan-baseline.neon
