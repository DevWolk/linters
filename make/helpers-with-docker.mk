DOCKER_FILE := -f ./docker/docker-compose.yml
DOCKER_ENV := ./docker/.env
DOCKER_ENV_EXAMPLE := ./docker/.env.example

env-init: ## Copy .env.example to .env if .env doesn't exist
	-@test -f $(DOCKER_ENV) || cp $(DOCKER_ENV_EXAMPLE) $(DOCKER_ENV)

fix-syntax-completely: ## Fix code style by all code style instruments
	$(MAKE) syntax-fix
	$(MAKE) rector
	$(MAKE) php-cs-fixer
	$(MAKE) syntax
	$(MAKE) rector-dry-run
	$(MAKE) php-cs-fixer-check
	$(MAKE) phpmd
	$(MAKE) phpstan
	$(MAKE) composer-validate
	$(MAKE) composer-audit
	$(MAKE) composer-normalize
	$(MAKE) composer-unused
	$(MAKE) test-unit

test-unit: ## Run unit tests
	docker compose exec -T php vendor/bin/phpunit -d memory_limit=512M --order-by=random --colors=always

syntax: ## Check code style with PHPCS
	docker compose exec -T php ./bin/linters run phpcs

syntax-fix: ## Fix code style with PHPCBF
	docker compose exec -T php ./bin/linters run phpcbf

rector: ## Fix code style with Rector
	docker compose exec -T php ./bin/linters run rector
rector-dry-run: ## Check code style with Rector (dry-run)
	docker compose exec -T php ./bin/linters run rector -- --dry-run

php-cs-fixer: ## Fix code style with PHP-CS-Fixer
	docker compose exec -T php ./bin/linters run php-cs-fixer
php-cs-fixer-check: ## Check code style with PHP-CS-Fixer (dry-run)
	docker compose exec -T php ./bin/linters run php-cs-fixer -- --dry-run --diff

phpstan: ## Static analysis with PHPStan
	docker compose exec -T php ./bin/linters run phpstan
phpstan-baseline: ## Generate PHPStan baseline
	docker compose exec -T php ./bin/linters run phpstan -- --generate-baseline --allow-empty-baseline

phpmd: ## Detect code quality issues with PHPMD
	docker compose exec -T php ./bin/linters run phpmd

composer-validate: ## Validate composer.json
	docker compose exec -T php composer validate --strict
composer-audit: ## Check security vulnerabilities
	docker compose exec -T php composer audit
composer-unused: ## Find unused composer dependencies
	docker compose exec -T php ./bin/linters run composer-unused
composer-normalize: ## Normalize composer.json
	docker compose exec -T php ./bin/linters run composer-normalize

config-generate: env-init ## Generate config file
	printf "${COLOR_COMMENT}Generate config file...${COLOR_RESET}\n"
	echo "# DO NOT EDIT THIS FILE" > docker-compose.yml
	echo "# THIS FILE GENERATED AUTOMATICALLY" >> docker-compose.yml
	docker compose $(DOCKER_FILE) config >> docker-compose.yml
	printf "${COLOR_COMMENT}Done${COLOR_RESET}\n"
build: config-generate ## For initial build
	docker compose build --no-cache --pull --progress=plain
up: config-generate ## Up docker environment
	docker compose up -d --remove-orphans
down: ## Down docker environment
	docker compose down
stop: ## Stop docker environment
	docker compose stop
bash: ## Run bash console in Ubuntu based docker images.
	docker compose exec php bash
