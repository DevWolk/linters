#!/usr/bin/env php
<?php

declare(strict_types=1);

use Linters\Console\Application;

$autoloaders = [
    __DIR__ . '/../vendor/autoload.php', // running from repository
    __DIR__ . '/../autoload.php',        // running from vendor/bin copy
    __DIR__ . '/../../../autoload.php',  // running from installed package
];

$autoloader = null;
foreach ($autoloaders as $path) {
    if (file_exists($path)) {
        $autoloader = $path;
        break;
    }
}

if ($autoloader === null) {
    fwrite(STDERR, "[ERROR] Unable to locate Composer autoloader.\n");
    exit(1);
}

require_once $autoloader;

$application = new Application();
$application->setAutoExit(false);

try {
    $application->run();
} catch (Exception $exception) {
    fwrite(STDERR, '[ERROR] ' . $exception->getMessage() . "\n");
    exit(1);
}
