{
  "name": "devwolk/linters",
  "description": "Centralized PHP linter configurations and static analysis tools for PHP projects",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "linter",
    "phpstan",
    "rector",
    "php-cs-fixer",
    "phpcs",
    "phpmd",
    "composer-unused",
    "composer-normalize",
    "static-analysis",
    "code-quality"
  ],
  "require": {
    "php": ">=8.3",
    "ext-dom": "*",
    "friendsofphp/php-cs-fixer": "^3",
    "rector/rector": "^2.3",
    "slevomat/coding-standard": "^8",
    "squizlabs/php_codesniffer": "^3.1.0 || ^4.0",
    "symfony/console": "^6.0 || ^7.0 || ^8.0",
    "symfony/filesystem": "^7.0 || ^8.0",
    "thecodingmachine/phpstan-safe-rule": "^1.4",
    "thecodingmachine/safe": "^3.3"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.48",
    "icanhazstring/composer-unused": "^0.9.5",
    "phpmd/phpmd": "^2.15",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-mockery": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.5",
    "roave/security-advisories": "dev-latest"
  },
  "suggest": {
    "driftingly/rector-laravel": "Enable Laravel Rector sets when rector.sets includes laravel."
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Linters\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Linters\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/linters"
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    },
    "classmap-authoritative": true,
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "linters": {
      "composer-unused": {
        "named-filters": [
          "friendsofphp/php-cs-fixer",
          "slevomat/coding-standard",
          "squizlabs/php_codesniffer",
          "thecodingmachine/phpstan-safe-rule",
          "roave/security-advisories"
        ]
      },
      "php-cs-fixer": {
        "parallel": true,
        "paths": [
          "src",
          "tests"
        ],
        "skip-dirs": [
          "vendor"
        ]
      },
      "phpcs": {
        "parallel": 4,
        "paths": [
          "src",
          "tests"
        ],
        "rule-excludes": {
          "Generic.Files.LineLength.TooLong": [
            "src/CommandBuilder/Contracts/AbstractConfigurableCommandBuilder.php"
          ]
        },
        "skip-dirs": [
          "vendor"
        ]
      },
      "phpmd": {
        "baseline": "phpmd.baseline.xml",
        "paths": [
          "src",
          "tests"
        ],
        "skip-dirs": [
          "vendor"
        ]
      },
      "phpstan": {
        "baseline": "phpstan-baseline.neon",
        "parallel": true,
        "paths": [
          "src",
          "tests"
        ],
        "skip-dirs": [
          "vendor"
        ]
      },
      "rector": {
        "parallel": {
          "enabled": true,
          "files-per-process": 80,
          "max-processes": 4,
          "timeout": 360
        },
        "paths": [
          "src",
          "tests"
        ],
        "php-version": "8.4",
        "sets": [
          "laravel12",
          "phpunit12",
          "doctrine"
        ],
        "skip-dirs": [
          "vendor"
        ]
      }
    }
  }
}
