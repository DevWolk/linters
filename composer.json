{
  "name": "devwolk/linters",
  "description": "Centralized PHP linter configurations and static analysis tools for PHP projects",
  "license": "MIT",
  "type": "library",
  "version": "0.0.1",
  "keywords": [
    "linter",
    "phpstan",
    "rector",
    "php-cs-fixer",
    "phpcs",
    "phpmd",
    "composer-unused",
    "composer-normalize",
    "static-analysis",
    "code-quality"
  ],
  "require": {
    "php": "^8.4",
    "ext-dom": "*",
    "ergebnis/composer-normalize": "^2.48",
    "friendsofphp/php-cs-fixer": "^3.90",
    "icanhazstring/composer-unused": "^0.9",
    "phpmd/phpmd": "^2.15",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-mockery": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^2.3",
    "roave/security-advisories": "dev-latest",
    "slevomat/coding-standard": "^8.26",
    "squizlabs/php_codesniffer": "^4.0",
    "symfony/console": "^7.3",
    "symfony/filesystem": "^7.4",
    "thecodingmachine/phpstan-safe-rule": "^1.4",
    "thecodingmachine/safe": "^3.3"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.1",
    "laravel/framework": "^12.47",
    "phpunit/phpunit": "^12.5"
  },
  "suggest": {
    "driftingly/rector-laravel": "Enable Laravel Rector sets when rector.sets includes laravel."
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Linters\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Linters\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/linters"
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "linters": {
      "composer-unused": {
        "named-filters": []
      },
      "php-cs-fixer": {
        "cache_dir": ".cache/php-cs-fixer",
        "parallel": true,
        "paths": [
          "src",
          "tests"
        ],
        "skip_dirs": [
          "vendor"
        ]
      },
      "phpcs": {
        "cache_dir": ".cache/phpcs",
        "parallel": 4,
        "paths": [
          "src",
          "tests"
        ],
        "skip_dirs": ["vendor"],
        "skip_files": ["tests/TestCase.php", "*\\.blade\\.php$"]
      },
      "phpmd": {
        "paths": [
          "src",
          "tests"
        ],
        "skip_dirs": [
          "vendor"
        ]
      },
      "phpstan": {
        "baseline": "phpstan-baseline.neon",
        "cache_dir": ".cache/phpstan",
        "parallel": true,
        "paths": [
          "src",
          "tests"
        ],
        "skip_dirs": [
          "vendor"
        ]
      },
      "rector": {
        "cache_dir": ".cache/rector",
        "parallel": {
          "parallel": true,
          "filesPerProcess": 40,
          "timeout":360,
          "maxProcesses": 2
        },
        "paths": [
          "src",
          "tests"
        ],
        "phpVersion": "8.4",
        "sets": [
          "laravel12",
          "phpunit12",
          "doctrine"
        ],
        "skip_dirs": [
          "vendor"
        ]
      }
    }
  }
}
