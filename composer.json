{
  "name": "devwolk/linters",
  "description": "Centralized PHP linter configurations and static analysis tools for PHP projects",
  "version": "0.0.1",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "linter",
    "phpstan",
    "rector",
    "php-cs-fixer",
    "phpcs",
    "phpmd",
    "static-analysis",
    "code-quality"
  ],
  "require": {
    "php": "^8.2",
    "ext-dom": "*",
    "friendsofphp/php-cs-fixer": "^3.89",
    "icanhazstring/composer-unused": "^0.9.5",
    "phpmd/phpmd": "^2.15",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-mockery": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^2.2",
    "roave/security-advisories": "dev-latest",
    "slevomat/coding-standard": "^8.24",
    "squizlabs/php_codesniffer": "^4.0",
    "thecodingmachine/phpstan-safe-rule": "^1.4",
    "symfony/console": "^7.3"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.48",
    "phpunit/phpunit": "^11.0"
  },
  "suggest": {
    "rector/rector-laravel": "Enable Laravel Rector sets when rector.frameworks includes laravel.",
    "rector/rector-symfony": "Enable Symfony Rector sets when rector.frameworks includes symfony."
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Linters\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Linters\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/linters"
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "rector": [
      "./vendor/bin/rector process --config=./configs/rector.php --clear-cache"
    ],
    "rector-check": [
      "./vendor/bin/rector process --config=./configs/rector.php --clear-cache --dry-run"
    ],
    "php-cs-fixer": [
      "./vendor/bin/php-cs-fixer fix --config=./configs/.php-cs-fixer.dist.php --allow-risky=yes --using-cache=no"
    ],
    "php-cs-fixer-check": [
      "./vendor/bin/php-cs-fixer fix --dry-run --config=./configs/.php-cs-fixer.dist.php --diff -vv --allow-risky=yes --using-cache=no"
    ],
    "phpstan": [
      "./bin/linters run phpstan"
    ],
    "phpstan-baseline": [
      "./bin/linters generate phpstan",
      "./vendor/bin/phpstan analyze --configuration=./phpstan.neon --generate-baseline"
    ],
    "phpcs": [
      "./bin/linters run phpcs"
    ],
    "phpmd": [
      "./bin/linters run phpmd"
    ],
    "composer-unused": [
      "./vendor/bin/composer-unused --configuration=./configs/composer-unused.php"
    ],
    "test": [
      "./vendor/bin/phpunit --configuration=./phpunit.xml"
    ]
  }
}
