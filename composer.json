{
  "name": "devwolk/linters",
  "description": "Centralized PHP linter configurations and static analysis tools for PHP projects",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "linter",
    "phpstan",
    "rector",
    "php-cs-fixer",
    "phpcs",
    "phpmd",
    "composer-unused",
    "composer-normalize",
    "static-analysis",
    "code-quality"
  ],
  "require": {
    "php": ">=8.4.1",
    "ext-dom": "*",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpmd/phpmd": "^3.0@dev",
    "phpstan/phpstan": "^2.2",
    "rector/rector": "^2.6",
    "slevomat/coding-standard": "^8.31",
    "squizlabs/php_codesniffer": "^4.0",
    "symfony/console": "^8.1",
    "symfony/filesystem": "^8.1",
    "thecodingmachine/phpstan-safe-rule": "^1.4",
    "thecodingmachine/safe": "^3.4"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.5",
    "ergebnis/composer-normalize": "^2.52",
    "icanhazstring/composer-unused": "^0.9.6",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-mockery": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.2",
    "roave/security-advisories": "dev-latest"
  },
  "suggest": {
    "driftingly/rector-laravel": "Enable Laravel Rector sets when rector.sets includes laravel."
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Linters\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Linters\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/linters"
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    },
    "classmap-authoritative": true,
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "linters": {
      "composer-unused": {
        "named-filters": [
          "friendsofphp/php-cs-fixer",
          "phpmd/phpmd",
          "slevomat/coding-standard",
          "squizlabs/php_codesniffer",
          "thecodingmachine/phpstan-safe-rule"
        ]
      },
      "php-cs-fixer": {
        "parallel": true,
        "paths": [
          "src",
          "tests"
        ],
        "skip-dirs": [
          "vendor"
        ]
      },
      "phpcs": {
        "parallel": 4,
        "paths": [
          "src",
          "tests"
        ],
        "rule-excludes": {
          "Generic.Files.LineLength.TooLong": [
            "src/CommandBuilder/Contracts/AbstractConfigurableCommandBuilder.php"
          ]
        },
        "skip-dirs": [
          "vendor"
        ]
      },
      "phpmd": {
        "cache-dir": ".cache/phpmd",
        "parallel": 4,
        "paths": [
          "src",
          "tests"
        ],
        "skip-dirs": [
          "vendor"
        ]
      },
      "phpstan": {
        "parallel": true,
        "paths": [
          "src",
          "tests"
        ],
        "skip-dirs": [
          "vendor"
        ]
      },
      "rector": {
        "import-names": {
          "import-doc-block-names": false,
          "import-names": true,
          "import-short-classes": false,
          "remove-unused-imports": true
        },
        "parallel": {
          "enabled": true,
          "files-per-process": 80,
          "max-processes": 4,
          "timeout": 360
        },
        "paths": [
          "src",
          "tests"
        ],
        "php-version": "8.4",
        "sets": [
          "phpunit13",
          "doctrine"
        ],
        "skip-dirs": [
          "vendor"
        ],
        "unsafe": {
          "treat-classes-as-final": true
        }
      }
    }
  }
}
