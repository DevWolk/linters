{
  "name": "example/laravel-project",
  "description": "Example Laravel project with devwolk/linters",
  "type": "project",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^11.0"
  },
  "require-dev": {
    "devwolk/linters": "^0.0.1",
      "driftingly/rector-laravel": "^2.1"
  },
  "extra": {
    "linters": {
      "rector": {
        "paths": ["app", "config", "database", "routes", "tests"],
        "skip_dirs": ["bootstrap", "storage", "vendor"],
        "skip_files": [],
        "sets": ["laravel"],
        "parallel": {
          "parallel": true,
          "filesPerProcess": 40,
          "timeout":360,
          "maxProcesses": 2
        },
        "cache_dir": ".cache/rector"
      },
      "php-cs-fixer": {
        "paths": ["app", "config", "database", "routes"],
        "skip_dirs": ["resources/views"],
        "skip_files": [],
        "parallel": true,
        "cache_dir": ".cache/php-cs-fixer"
      },
      "phpstan": {
        "paths": ["app", "tests"],
        "skip_dirs": ["vendor", "storage", "bootstrap/cache"],
        "skip_files": [],
        "parallel": true,
        "cache_dir": ".cache/phpstan"
      },
      "phpcs": {
        "paths": ["app", "config"],
        "skip_dirs": ["resources/views"],
        "skip_files": [],
        "parallel": 4,
        "cache_dir": ".cache/phpcs"
      },
      "phpmd": {
        "paths": ["app"],
        "skip_dirs": [],
        "skip_files": []
      },
      "composer-unused": {
        "named-filters": [
          "wikimedia/composer-merge-plugin"
        ]
      }
    }
  }
}
