{
  "name": "example/symfony-project",
  "description": "Example Symfony project with devwolk/linters",
  "type": "project",
  "require": {
    "php": "^8.4",
    "symfony/framework-bundle": "^7.0"
  },
  "require-dev": {
    "devwolk/linters": "^0.0.1"
  },
  "extra": {
    "linters": {
      "rector": {
        "paths": ["src", "tests"],
        "php-version": "8.4",
        "skip-dirs": ["var", "vendor"],
        "skip-files": ["src/Kernel.php"],
        "sets": ["symfony"],
        "parallel": {
          "enabled": true,
          "files-per-process": 40,
          "timeout": 360,
          "max-processes": 2
        },
        "cache-dir": ".cache/rector"
      },
      "php-cs-fixer": {
        "paths": ["src"],
        "skip-dirs": ["templates"],
        "skip-files": [],
        "parallel": true,
        "cache-dir": ".cache/php-cs-fixer"
      },
      "phpstan": {
        "paths": ["src", "tests"],
        "skip-dirs": ["vendor", "var"],
        "skip-files": [],
        "parallel": true,
        "cache-dir": ".cache/phpstan"
      },
      "phpcs": {
        "paths": ["src"],
        "skip-dirs": ["templates"],
        "skip-files": [],
        "parallel": 4,
        "cache-dir": ".cache/phpcs"
      },
      "phpmd": {
        "paths": ["src"],
        "skip-dirs": [],
        "skip-files": []
      },
      "composer-unused": {
        "named-filters": [
          "friendsofphp/php-cs-fixer",
          "slevomat/coding-standard",
          "squizlabs/php_codesniffer"
        ]
      }
    }
  }
}
