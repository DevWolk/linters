{
  "name": "example/symfony-project",
  "description": "Example Symfony project with devwolk/linters",
  "type": "project",
  "require": {
    "php": "^8.4",
    "symfony/framework-bundle": "^7.0"
  },
  "require-dev": {
    "devwolk/linters": "^0.0.1"
  },
  "extra": {
    "linters": {
      "rector": {
        "paths": ["src", "tests"],
        "skip_dirs": ["var", "vendor"],
        "skip_files": ["src/Kernel.php"],
        "sets": ["symfony"],
        "parallel": {
          "parallel": true,
          "filesPerProcess": 40,
          "timeout":360,
          "maxProcesses": 2
        },
        "cache_dir": ".cache/rector"
      },
      "php-cs-fixer": {
        "paths": ["src"],
        "skip_dirs": ["templates"],
        "skip_files": [],
        "parallel": true,
        "cache_dir": ".cache/php-cs-fixer"
      },
      "phpstan": {
        "paths": ["src", "tests"],
        "skip_dirs": ["vendor", "var"],
        "skip_files": [],
        "parallel": true,
        "cache_dir": ".cache/phpstan"
      },
      "phpcs": {
        "paths": ["src"],
        "skip_dirs": ["templates"],
        "skip_files": [],
        "parallel": 4,
        "cache_dir": ".cache/phpcs"
      },
      "phpmd": {
        "paths": ["src"],
        "skip_dirs": [],
        "skip_files": []
      },
      "composer-unused": {
        "named-filters": [
          "wikimedia/composer-merge-plugin"
        ]
      }
    }
  },
  "scripts": {
    "rector": "./vendor/bin/linters run rector",
    "rector-check": [
      "./vendor/bin/linters generate rector",
      "./vendor/bin/rector process --config=./rector.php --dry-run"
    ],
    "php-cs-fixer": "./vendor/bin/linters run php-cs-fixer",
    "php-cs-fixer-check": [
      "./vendor/bin/linters generate php-cs-fixer",
      "./vendor/bin/php-cs-fixer fix --dry-run --config=./.php-cs-fixer.php --diff"
    ],
    "phpstan": "./vendor/bin/linters run phpstan",
    "phpstan-baseline": [
      "./vendor/bin/linters generate phpstan",
      "./vendor/bin/phpstan analyze --configuration=./phpstan.neon --generate-baseline"
    ],
    "phpcs": "./vendor/bin/linters run phpcs",
    "phpmd": "./vendor/bin/linters run phpmd",
    "composer-unused": "./vendor/bin/linters run composer-unused",
    "lint": ["@rector-check", "@php-cs-fixer-check", "@phpstan", "@phpcs"],
    "lint-fix": ["@rector", "@php-cs-fixer"]
  }
}
